{
  "name": "jaguara-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "api:gerar": "openapi-typescript api/openapi.yaml -o src/api/esquema.ts",
    "api:contrato": "node -e \"fetch('https://raw.githubusercontent.com/JaguaraPet/Jaguara_doc/main/docs/03-arquitetura/api/openapi.yaml').then(r=>r.text()).then(t=>require('fs').writeFileSync('api/openapi.yaml',t))\""
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/ui": "~58.0.28",
    "@expo/vector-icons": "^15.0.2",
    "@types/jest": "30.0.0",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-notifications": "58.1.8",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "openapi-typescript": "7.13.0",
    "typescript": "~7.0.2"
  },
  "allowScripts": {
    "@parcel/watcher": false
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
